# Copy to .env and fill in. .env is gitignored and never committed.

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Gmail address and 16-character app password used to send candidate emails.
# Leave blank to run without email (sends will fail and be reported in the UI).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_NAME=HR Team

# Seed credentials for the first HR account (used only on an empty database).
HR_ADMIN_USERNAME=hradmin
HR_ADMIN_PASSWORD=

# Set to 1 for local development only. Never in production.
FLASK_DEBUG=0

# LLM-based resume extraction. Leave blank to stay fully offline.
# Gemini (Google AI Studio) has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Alternative provider - only needed if you are NOT using Gemini.
ANTHROPIC_API_KEY=
RESUME_EXTRACTION_MODEL=claude-opus-5

# Scoring performance
# Concurrent LLM calls when ranking (free-tier quotas are per-minute).
SCORING_CONCURRENCY=4
# Rank everyone locally first, then send only the top N to the LLM.
# 0 = send every resume. Useful when you have 100+ applicants per job.
LLM_TOP_N=0
